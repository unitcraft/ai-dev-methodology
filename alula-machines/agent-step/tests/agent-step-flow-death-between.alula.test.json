{
  "kind": "test",
  "machine": "agent_step",
  "name": "the process dies between the commit and the send: the restart sends the request once",
  "start_at": 1000,
  "steps": [
    {
      "do": "accept",
      "event": {
        "kind": "start",
        "request": "call-1",
        "input": {
          "kind": {
            "$variant": "CallerKind",
            "name": "CycleSession",
            "fields": {}
          },
          "profile": {
            "$record": "AgentProfile",
            "fields": {
              "family": "claude",
              "model": "m1",
              "effort": null
            }
          },
          "session": "s1",
          "dialog_kind": "main",
          "context": "ctx",
          "limits": {
            "$record": "AgentLimits",
            "fields": {
              "silence_term": null,
              "token_budget": null,
              "cost_budget": null,
              "turn_limit": null
            }
          },
          "trace": "t1",
          "step": 0
        }
      },
      "host": {
        "reply_validation": {
          "$variant": "ReplyCheck",
          "name": "Valid",
          "fields": {}
        },
        "close_agent_turn": null
      },
      "expect": {
        "state": "AgentTurn",
        "queue": [
          "send agent-1"
        ],
        "open": [
          "agent-1"
        ],
        "sent": []
      }
    },
    {
      "do": "restart",
      "expect": {
        "state": "AgentTurn",
        "sent": []
      }
    },
    {
      "do": "dispatch",
      "expect": {
        "queue": [],
        "sent": [
          "agent-1"
        ]
      }
    },
    {
      "do": "dispatch",
      "expect": {
        "sent": [
          "agent-1"
        ]
      }
    },
    {
      "do": "feed",
      "event": {
        "kind": "answer",
        "name": "agent_done",
        "request": "agent-1",
        "input": {
          "case": "Finished",
          "fields": {
            "text": {
              "some": "hello"
            },
            "artifact": {
              "none": true
            },
            "usage": {
              "model": {
                "id": "m1",
                "provider": "p",
                "variant": {
                  "none": true
                }
              },
              "tokens": {
                "input": {
                  "some": 10
                },
                "output": {
                  "some": 5
                },
                "reasoning": {
                  "none": true
                },
                "cache_read": {
                  "none": true
                },
                "cache_write": {
                  "none": true
                }
              },
              "cost": {
                "none": true
              },
              "context_used": {
                "none": true
              },
              "request_started": 5
            }
          }
        }
      },
      "expect": {
        "state": "End",
        "journal": [
          {
            "code": "agent_usage",
            "params": {
              "session": "s1",
              "result": "reply",
              "model": "m1",
              "input": "10",
              "output": "5",
              "reasoning": "none",
              "cache_read": "none",
              "cache_write": "none",
              "cost": "none"
            }
          }
        ]
      }
    }
  ]
}
