{
  "kind": "test",
  "machine": "agent_step",
  "name": "REPLY VALIDATION 3: a reply that breaks the form is returned once: the turn is \"fix\"",
  "start_at": 1000,
  "steps": [
    {
      "do": "feed",
      "event": {
        "kind": "start",
        "request": "call-1",
        "input": {
          "kind": {
            "$variant": "CallerKind",
            "name": "CycleSession",
            "fields": {}
          },
          "profile": {
            "$record": "AgentProfile",
            "fields": {
              "family": "claude",
              "model": "m1",
              "effort": null
            }
          },
          "session": "s1",
          "dialog_kind": "main",
          "context": "ctx",
          "limits": {
            "$record": "AgentLimits",
            "fields": {
              "silence_term": null,
              "token_budget": null,
              "cost_budget": null,
              "turn_limit": null
            }
          },
          "trace": "t1",
          "step": 0
        }
      },
      "host": {
        "reply_validation": {
          "$variant": "ReplyCheck",
          "name": "Valid",
          "fields": {}
        },
        "close_agent_turn": null
      },
      "expect": {
        "state": "AgentTurn",
        "journal": [],
        "data": {
          "turn_count": 1,
          "started": {
            "$some": 1000
          },
          "turn": "first",
          "agent_attempt": 1,
          "open_requests": [
            "agent-1"
          ],
          "call_request_id": "call-1"
        },
        "open": [
          "agent-1"
        ],
        "sent": [
          "agent-1"
        ]
      }
    },
    {
      "do": "feed",
      "event": {
        "kind": "answer",
        "name": "agent_done",
        "request": "agent-1",
        "input": {
          "case": "Finished",
          "fields": {
            "text": {
              "some": "hello"
            },
            "artifact": {
              "none": true
            },
            "usage": {
              "model": {
                "id": "m1",
                "provider": "p",
                "variant": {
                  "none": true
                }
              },
              "tokens": {
                "input": {
                  "some": 10
                },
                "output": {
                  "some": 5
                },
                "reasoning": {
                  "none": true
                },
                "cache_read": {
                  "none": true
                },
                "cache_write": {
                  "none": true
                }
              },
              "cost": {
                "none": true
              },
              "context_used": {
                "none": true
              },
              "request_started": 5
            }
          }
        }
      },
      "host": {
        "reply_validation": {
          "$variant": "ReplyCheck",
          "name": "Violated",
          "fields": {}
        }
      },
      "expect": {
        "state": "AgentTurn",
        "journal": [
          {
            "code": "reply_form_violated"
          }
        ],
        "data": {
          "return_count": 1,
          "turn": "fix",
          "turn_count": 2
        },
        "open": [
          "agent-2"
        ],
        "sent": [
          "agent-1",
          "agent-2"
        ]
      }
    }
  ]
}
